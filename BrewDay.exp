BEGIN;
 
PROJECT, "Two-Batch Brew Day", "Kate Hamilton", 11/09/2026;
 
ATTRIBUTES: Seq: BType: ArrT: TStamp: TMashIn: TLeaveMT:
            TrBoil: PreBoilT: TrFerm: TMTWait: TBTWait: TFWait: TunIdx: F2Ready;
 
VARIABLES:
;   ---- decision variables / scenario controls
            TB2, 300:                    Batch 2 release, min after start
            Beer1Type, 1:
            Beer2Type, 1:
;   ---- water rates (gal/min) and buffer
            FillRate, 2.5:               measured on 10/15/26 boards (2.4, 2.8);
;                                         used for every hot-water fill
            DrainRate, 2.0:
            Buf, 1:
;   ---- deterministic brewing steps (min)
;        MashT = rest after mash-in; mash-in + rest = 60 min (boards 7/12, 10/15)
            MashInT, 12:  MashT, 48:  MashOutT, 10:  RecircT, 30:  BoilT, 60:
;   ---- mash-water volume by group (gal), group means of recipe depths
            FillVol(3), 55.1, 66.2, 73.9:
;   ---- tun cleaning (5 in x 3.155 gal/in = 15.8 gal)
            CleanVol, 15.8:  ScrubT, 5:  TunSoak, 30:
;   ---- fermenter cleaning (both fermenters, one after the other)
;        FSit = OxiClean sit before draining (Jeff: 5 min)
;        FermVol, SanVol, SanSit, SanXfer are PLACEHOLDERS - confirm
            FermVol, 10:  FSit, 5:
            SanVol, 10:  ColdRate, 5.0:  SanSit, 5:  SanXfer, 5:
;   ---- pre-boil conditional model
            PBMean(3), 56.6, 47.1, 47.1:
            PBSD(3), 10.2, 11.4, 11.4:
            PBRho, -0.62:  PBk, 0.7846:  TrMean, 46.1:  TrSD, 16.8:
;   ---- state variables
            CleanFerm, 0:  MTCleanT, 0:  MTIdle, 0:  LeaveMT1, 0;
 
RESOURCES:  Jeff, 1:
            HotWater, 1:
            MashTun, 1:
            BoilTun, 1:
            ChillPlate, 1;
 
QUEUES:     MashTunQ, FIFO:  BoilTunQ, FIFO:  FermQ, FIFO:  ChillQ, FIFO:
            JBufFillQ, FIFO: JMashInQ, FIFO:  JBufMashQ, FIFO: JBufMOQ, FIFO:
            JSpargeQ, FIFO:  JBufFermQ, FIFO:
            HWFillQ, FIFO:   HWSpargeQ, FIFO:
            FCFill1Q, FIFO:  FCFill2Q, FIFO:
            FCR1ScanQ, FIFO: FCR1JQ, FIFO: FCR1HQ, FIFO:
            FCR2ScanQ, FIFO: FCR2JQ, FIFO: FCR2HQ, FIFO:
            TCFillQ, FIFO:   TCScrub1Q, FIFO: TCScrub2Q, FIFO;
 
COUNTERS:   BatchesDone, 2;
 
TALLIES:    Makespan:  B2MTWait:  Conflict:  MTIdleT:
            B2BTWait:  B2FWait:   B2Gap:     BatchCycle;
 
DSTATS:     NR(Jeff),       Jeff Busy:
            NR(HotWater),   Hot Water Busy:
            NR(MashTun),    Mash Tun Occupied:
            NR(BoilTun),    Boil Tun Occupied:
            NR(ChillPlate), Chill Plate Busy;
 
SEEDS:      1, 100, No:
            2, 110, No:
            3, 120, No:
            4, 130, No:
            5, 140, No:
            6, 150, No;
 
REPLICATE,  500, 0, 1440, Yes, Yes, 0, , , ,Minutes;
 
END;
 
